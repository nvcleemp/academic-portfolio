<!-- Publications Tab Panel -->
<div class="tab-panel" data-tab="publications">
  <section class="section">
    <h2 class="section-title">Publications</h2>
    <ol reversed class="publications-list" style="counter-reset: publication {{ publications | length + 1 }};">
      {% for pub in publications %}
      <li{% if pub.status == "submitted" %} class="not-accepted"{% endif %}>
        {{ pub.authors }}, <em>{{ pub.title }}</em>
        {%- if pub.journal %}, {{ pub.journal }}
          {%- if pub.volume %}, {% if "<strong>" not in pub.volume %}<strong>{{ pub.volume }}</strong>{% else %}{{ pub.volume | safe }}{% endif %}{% endif %}
          {%- if pub.issue %} ({{ pub.issue }}){% endif %}
          {%- if pub.month %}, {{ pub.month }}{% endif %}
          {%- if pub.year %} {{ pub.year }}{% endif %}
          {%- if pub.articleNumber %}, {{ pub.articleNumber }}{% endif %}
          {%- if pub.pages %}, pp. {{ pub.pages }}{% endif %}
          {%- if pub.location %}, {{ pub.location }}{% endif %}
        {%- endif %}
        {%- if pub.doi or pub.arxiv or pub.link or pub.link2 %} (
          {%- if pub.doi %}<a href="{{ pub.doi }}">DOI</a>{% endif %}
          {%- if pub.arxiv %}{% if pub.doi %}/{% endif %}<a href="{{ pub.arxiv }}">arXiv</a>{% endif %}
          {%- if pub.link %}{% if pub.doi or pub.arxiv %} | {% endif %}<a href="{{ pub.link }}">link</a>{% endif %}
          {%- if pub.link2 %} or <a href="{{ pub.link2 }}">(direct link)</a>{% endif %}
        ){% endif %}
        {%- if pub.status == "submitted" %}, submitted{% endif %}.
      </li>
      {% endfor %}
    </ol>
  </section>

  <section class="section mt-lg">
    <div class="card phd-wrapper">
      <div class="profile-section">
        <div>
          <img src="/images/thesis.png" alt="PhD Dissertation Cover" class="profile-image">
        </div>
        <div class="card">
          <h3>PhD Dissertation</h3>
          <p>On 21 September 2012 I defended my PhD with the title "Generation of structures in chemistry and mathematics". You can find the dissertation on the website of Ghent University at <a href="http://hdl.handle.net/1854/LU-3052922" target="_blank">this link</a>.</p>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Conferences Tab Panel -->
<div class="tab-panel" data-tab="conferences">
  <section class="section">
    <h2 class="section-title">Conferences & Talks</h2>
    
    <div class="subsection">
      <h3 class="subsection-title">Talks</h3>
      <ul>
        {% for conf in conferences %}
          {% if conf.type == "talk" %}
        <li>{{ conf.title }} ({{ conf.location }}, {{ conf.date }}): {% if conf.talkTitle %}{{ conf.talkTitle }}{% endif %}{% if conf.notes %} ({{ conf.notes }}){% endif %}{% if conf.links %}: {% for link in conf.links %}<a href="{{ link.url }}" target="_blank">{{ link.type | capitalize }}</a>{% if not loop.last %}/{% endif %}{% endfor %}{% endif %}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="subsection">
      <h3 class="subsection-title">Posters</h3>
      <ul>
        {% for conf in conferences %}
          {% if conf.type == "poster" %}
        <li>{{ conf.title }} ({{ conf.date }}){% if conf.notes %} ({{ conf.notes }}){% endif %}{% if conf.links %}: {% for link in conf.links %}<a href="{{ link.url }}" target="_blank">{{ link.type | capitalize }}</a>{% if not loop.last %}/{% endif %}{% endfor %}{% endif %}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="subsection">
      <h3 class="subsection-title">Attended Conferences</h3>
      <p>Only the conferences where I did not give a presentation:</p>
      <ul>
        {% for conf in conferences %}
          {% if conf.type == "attended" %}
        <li>{{ conf.title }} ({{ conf.location }}, {{ conf.date }})</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="subsection">
      <h3 class="subsection-title">Organised Conferences</h3>
      <ul>
        {% for conf in conferences %}
          {% if conf.type == "organized" %}
        <li><a href="{{ conf.url }}" target="_blank">{{ conf.title }}</a> ({{ conf.collaborators }}) ({{ conf.location }}, {{ conf.date }})</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="subsection">
      <h3 class="subsection-title">Research Visits</h3>
      <ul>
        {% for visit in visits %}
        <li>visit to {{ visit.institution }} {{ visit.purpose }} ({{ visit.location }}, {{ visit.dates }})</li>
        {% endfor %}
      </ul>
    </div>
  </section>
</div>

<!-- Software Tab Panel -->
<div class="tab-panel" data-tab="software">
  <section class="section">
    <h2 class="section-title">Software</h2>
    <p>Software in which I played a significant role:</p>
    
    <div class="software-grid">
      {% for sw in software %}
      <a href="{{ sw.url }}" target="_blank" class="card-software">
        <img src="{{ sw.image }}" alt="{{ sw.name }}" class="card-software-bg">
        <div class="card-software-content">
          <h3 class="card-software-title">{{ sw.name }}</h3>
          <p class="card-software-description">{{ sw.description }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
</div>

<script>
// Image rotation for headshot
(function() {
  const image = document.getElementById("headshot");
  if (image) {
    const images = ["/images/nvcleemp.jpg", "/images/nvcleemp_oud.jpg"];
    let currentPos = 0;
    
    function nextPicture() {
      if (++currentPos >= images.length) currentPos = 0;
      image.src = images[currentPos];
    }
    
    setInterval(nextPicture, 8000);
  }
})();
</script>
