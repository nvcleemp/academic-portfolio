---
layout: base.njk
---

<article class="section">
  <nav class="mb-md">
    <a href="{{ '/' | url }}" class="text-muted">&larr; Back to Main Site</a>
  </nav>
  
  <div class="card">
    {% if title %}
    <h1>{{ title }}</h1>
    {% endif %}
    
    {% if conference %}
    <p class="text-muted mb-md">
      <strong>{{ conference }}</strong>{% if location %} &middot; {{ location }}{% endif %}{% if conferenceDate %} &middot; {{ conferenceDate }}{% endif %}
    </p>
    {% endif %}
    
    <div class="abstract-content">
      {{ content | safe }}
    </div>
  </div>
</article>
